# Copy to .env and fill in. Never commit .env.

# Admin login. Create the hash with: npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Local development (npm run dev) and production (shared Postgres):
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
# Passwords with special characters must be URL-encoded (or use only letters and digits).
DATABASE_URL=

# --- Optional ---
# PORT=5183
# HOST=0.0.0.0
# UPLOAD_DIR=./data/uploads
# Set to 1 only when nginx is in front and the app port is not reachable directly.
# TRUST_PROXY=1

# --- Dev server only (deploy/dev/docker-compose.yml runs its own Postgres) ---
# POSTGRES_DB=techbestie
# POSTGRES_USER=techbestie
# POSTGRES_PASSWORD=
# HOST_PORT=5183

# --- Prod server only: Docker network names of the shared nginx and Postgres ---
# NGINX_NETWORK=compose_nginx-network
# DB_NETWORK=shared-db-net
